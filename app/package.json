{
  "name": "dkm-dobor",
  "version": "3.0.0",
  "private": true,
  "description": "DKM Power Transmission — dobór przekładni ślimakowych (PWA + podstrona + plik offline)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "build:offline": "npm run build && node scripts/build-offline.mjs",
    "smoke": "node scripts/smoke.mjs",
    "fonts": "node scripts/fetch-fonts.mjs",
    "compare": "node scripts/compare.mjs",
    "verify": "node scripts/verify.mjs",
    "build:dkm": "VITE_DKM_HOSTS=\"dkm.pl,www.dkm.pl\" vite build && node scripts/postbuild.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "playwright": "^1.62.1",
    "vite": "^8.2.2"
  }
}
